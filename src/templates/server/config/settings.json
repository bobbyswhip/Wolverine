{
  "app": {
    "name": "Wolverine Server",
    "version": "1.0.0",
    "env": "development"
  },

  "models": {
    "reasoning": "gpt-4o",
    "coding": "gpt-4o",
    "chat": "gpt-4o-mini",
    "tool": "gpt-4o-mini",
    "classifier": "gpt-4o-mini",
    "audit": "gpt-4o-mini",
    "compacting": "gpt-4o-mini",
    "research": "gpt-4o"
  },

  "embedding": "wolverine-embedding-1",

  "server": {
    "port": 3000,
    "maxRetries": 3,
    "maxMemoryMB": 512
  },

  "telemetry": {
    "enabled": true,
    "heartbeatIntervalMs": 60000
  },

  "rateLimiting": {
    "maxCallsPerWindow": 32,
    "windowMs": 100000,
    "minGapMs": 5000,
    "maxTokensPerHour": 1000000
  },

  "healthCheck": {
    "intervalMs": 15000,
    "timeoutMs": 5000,
    "failThreshold": 3,
    "startDelayMs": 10000
  },

  "errorMonitor": {
    "defaultThreshold": 1,
    "windowMs": 30000,
    "cooldownMs": 60000
  },

  "autoUpdate": {
    "enabled": true,
    "intervalMs": 300000
  },

  "platform": {
    "apiKey": "",
    "cors": ["http://localhost:3000"]
  },

  "dashboard": {},

  "cors": {
    "enabled": true,
    "origins": ["http://localhost:3000"]
  },

  "logging": {
    "level": "info",
    "requests": true,
    "responseTime": true
  }
}
