# ══════════════════════════════════════════════════════════════════
# Wolverine Node.js — Environment Configuration
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — it contains secrets.
# ══════════════════════════════════════════════════════════════════

# ── API Key (required) ───────────────────────────────────────────
# Your OpenAI API key. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Server ───────────────────────────────────────────────────────
# Port for the user's server (wolverine manages this process)
PORT=3000

# Max repair attempts per crash before giving up
WOLVERINE_MAX_RETRIES=3

# ── Model Configuration ──────────────────────────────────────────
# 10 independent model slots — customize each for your cost/quality needs.
# Any OpenAI-compatible model name works. Reasoning models (o-series, gpt-5-nano)
# automatically get higher token limits to accommodate chain-of-thought.
#
# REASONING_MODEL    — Multi-file agent with full tool harness.
#                      Used for complex repairs that span multiple files.
#                      Needs: strong reasoning, tool calling support.
#                      Cost: highest (runs the 15-turn agent loop)
#
# CODING_MODEL       — Code generation and repair.
#                      Fast path single-file fixes + smart edit feature building.
#                      Needs: strong coding ability. Codex models use Responses API.
#                      Cost: medium-high (one call per fix, but outputs code)
#
# CHAT_MODEL         — Simple conversational responses (no tool calling).
#                      Used for SIMPLE route: explanations, knowledge questions.
#                      Needs: basic text generation. Can be nano/cheap.
#                      Cost: low
#
# TOOL_MODEL         — Chat responses that USE tools (call_endpoint, read_file, search_brain).
#                      Used for TOOLS route: live data, file contents, brain queries.
#                      Needs: function calling support (gpt-4o-mini+ or gpt-5.4-nano+).
#                      Cost: medium (tool calling adds tokens)
#
# CLASSIFIER_MODEL   — Routes commands: SIMPLE vs TOOLS vs AGENT + sizes SMALL/MEDIUM/LARGE.
#                      One word response per command. Can be cheapest model.
#                      Cost: ~10 tokens per classification
#
# AUDIT_MODEL        — Security: injection detection on every error.
#                      Scans error messages before they reach the repair model.
#                      Cost: runs on every crash, keep cheap
#
# COMPACTING_MODEL   — Compresses text before embedding into brain vector store.
#                      Makes embeddings more focused and search more accurate.
#                      Cost: low (short outputs)
#
# RESEARCH_MODEL     — Deep research when normal fixes fail.
#                      Triggered after 2+ failed repair attempts.
#                      Analyzes root causes and suggests new approaches.
#                      Cost: medium-high (but rarely triggered)
#
# TEXT_EMBEDDING_MODEL — Vector embeddings for the brain semantic search.
#                        Used for brain storage and recall.
#                        Cost: very low (embedding models are cheap)

REASONING_MODEL=gpt-5.4-mini
CODING_MODEL=gpt-5.1-codex-mini
CHAT_MODEL=gpt-5-nano
TOOL_MODEL=gpt-5.4-mini
AUDIT_MODEL=gpt-4o-mini
COMPACTING_MODEL=gpt-4o-mini
TEXT_EMBEDDING_MODEL=text-embedding-3-small
RESEARCH_MODEL=o4-mini-deep-research
CLASSIFIER_MODEL=gpt-4o-mini


# ── Rate Limiting ────────────────────────────────────────────────
# Prevents error explosions from draining your API budget.
# Sliding window + error loop detection with exponential backoff.

# Max API calls within the rolling window
WOLVERINE_RATE_MAX_CALLS=10
# Rolling window size in milliseconds (default: 10 min)
WOLVERINE_RATE_WINDOW_MS=600000
# Minimum gap between API calls in milliseconds
WOLVERINE_RATE_MIN_GAP_MS=5000
# Max estimated tokens per hour (budget protection)
WOLVERINE_RATE_MAX_TOKENS_HOUR=100000

# ── Dashboard Admin ──────────────────────────────────────────────
# Required to access the agent command interface on the dashboard.
# Only requests from localhost (127.0.0.1, ::1) with this key can issue commands.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WOLVERINE_ADMIN_KEY=

# ── Health Checks ────────────────────────────────────────────────
# PM2-style health monitoring. Pings the server periodically.
# After failThreshold consecutive failures, force-kills and triggers heal.

# WOLVERINE_HEALTH_INTERVAL_MS=15000
# WOLVERINE_HEALTH_TIMEOUT_MS=5000
# WOLVERINE_HEALTH_FAIL_THRESHOLD=3
# WOLVERINE_HEALTH_START_DELAY_MS=10000

# ── Dashboard Port ───────────────────────────────────────────────
# Dashboard runs on a separate port (default: PORT + 1)
# WOLVERINE_DASHBOARD_PORT=3001

# ── Platform Telemetry (optional) ────────────────────────────────
# Connect to a platform backend for fleet-wide monitoring.
# See PLATFORM.md for the backend spec and TELEMETRY.md for setup.
#
# Set the URL — wolverine auto-registers and manages the key.
# Key is saved to .wolverine/platform-key after first registration.
# Override with WOLVERINE_PLATFORM_KEY if you want to set it manually.
#
# WOLVERINE_PLATFORM_URL=https://your-platform.com
# WOLVERINE_INSTANCE_NAME=my-server-prod
# WOLVERINE_HEARTBEAT_INTERVAL_MS=60000

# ── Custom Secrets ───────────────────────────────────────────────
# Add any variable here and wolverine will automatically redact its value
# from all AI calls, logs, brain storage, and dashboard output.
# Values are replaced with process.env.KEY_NAME in error messages.
# You can pen test and verify rejection with this TEST_PHRASE variable 
TEST_PHRASE=beansontoast_6969696969
#
# Examples:
# DATABASE_URL=postgres://user:pass@host:5432/db
# JWT_SECRET=my-secret-key
# STRIPE_SECRET_KEY=sk_live_xxx

