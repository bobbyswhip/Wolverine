# Wolverine Node.js - Local Environment
# IMPORTANT: Never commit this file.

OPENAI_API_KEY=
PORT=6969
WOLVERINE_MAX_RETRIES=3

# ── Model Configuration ──────────────────────────────────────────
# Assign a model to each task type to optimize cost vs quality.
#
# REASONING_MODEL  — Deep analysis, complex multi-step debugging
#                    (most capable, highest cost — worth it for hard bugs)
# CODING_MODEL     — Code repair and fix generation
#                    (needs strong coding ability — don't cheap out here)
# CHAT_MODEL       — Explanations, summaries, user-facing messages
#                    (good but cheaper — doesn't need to write code)
# AUDIT_MODEL      — Security scans, prompt injection detection
#                    (runs on EVERY error — keep this cheap/nano)
# UTILITY_MODEL    — JSON formatting, regex validation, classification
#                    (simplest tasks — cheapest model possible)
# TEXT_EMBEDDING_MODEL    — JSON formatting, regex validation, classification
#                    (simplest tasks — cheapest model possible)

REASONING_MODEL=gpt-5.4
CODING_MODEL=gpt-5.3-codex
CHAT_MODEL=gpt-5.4-mini
AUDIT_MODEL=gpt-5.4-nano
UTILITY_MODEL=gpt-5.4-nano
TEXT_EMBEDDING_MODEL=text-embedding-3-small


# ── Rate Limiting ────────────────────────────────────────────────
WOLVERINE_RATE_MAX_CALLS=10
WOLVERINE_RATE_WINDOW_MS=600000
WOLVERINE_RATE_MIN_GAP_MS=5000
WOLVERINE_RATE_MAX_TOKENS_HOUR=100000

# ── Add your Own ────────────────────────────────────────────────
# You can add any variable to .env and woverine will protect it from being exposed
TEST_PHRASE=