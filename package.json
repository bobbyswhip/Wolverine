{
  "name": "wolverine-ai",
  "version": "4.0.5",
  "description": "Self-healing Node.js server framework powered by AI. Catches crashes, diagnoses errors, generates fixes, verifies, and restarts — automatically.",
  "main": "src/index.js",
  "bin": {
    "wolverine": "./bin/wolverine.js"
  },
  "scripts": {
    "start": "node bin/wolverine.js server/index.js",
    "dev": "node bin/wolverine.js server/index.js",
    "wolverine": "node bin/wolverine.js",
    "server": "node server/index.js",
    "demo": "node examples/run-demo.js",
    "demo:list": "node examples/run-demo.js --list",
    "test:pentest": "node tests/pentest-secrets.js"
  },
  "keywords": [
    "self-healing",
    "ai",
    "nodejs",
    "server",
    "error-recovery",
    "auto-repair",
    "process-manager",
    "openai",
    "fastify",
    "wolverine",
    "devops",
    "monitoring",
    "analytics",
    "dashboard",
    "mcp",
    "agent",
    "claude-code"
  ],
  "author": "bobbyswhip",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bobbyswhip/Wolverine.git"
  },
  "homepage": "https://github.com/bobbyswhip/Wolverine#readme",
  "bugs": {
    "url": "https://github.com/bobbyswhip/Wolverine/issues"
  },
  "files": [
    "bin/",
    "src/",
    "examples/",
    ".env.example"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@fastify/compress": "^8.0.0",
    "@fastify/cors": "^10.0.0",
    "chalk": "^4.1.2",
    "diff": "^7.0.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.8.4",
    "ioredis": "^5.0.0",
    "openai": "^4.73.0",
    "pg": "^8.0.0"
  },
  "optionalDependencies": {
    "@privy-io/server-auth": "1.14.0",
    "better-sqlite3": "^11.0.0",
    "ethers": "^6.0.0",
    "stripe": "^18.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
