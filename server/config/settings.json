{
  "app": {
    "name": "Wolverine Server",
    "version": "1.0.0",
    "env": "development"
  },

  // default model settings are provider grouped to show optimal prompt caching 
  // it's still best to use a single model across all tools for maximum cache hits
  "models": {
      "reasoning": "claude-sonnet-4-6",     // best at deep analysis (725 t/s, 64.9% SWE)
      "coding": "claude-sonnet-4-6",         // same model — shares Anthropic cache with reasoning
      "chat": "gpt-5.4-mini",               // fastest for summaries (318 t/s, cheap)
      "tool": "gpt-4o-mini",                // fastest tool parser (3652 t/s)
      "classifier": "gpt-4o-mini",           // fastest classifier (3652 t/s) — shares OpenAI cache with tool
      "audit": "wolverine-test-1",           // cheapest for security scan (self-hosted, $0)
      "compacting": "wolverine-test-1",      // cheapest for text compression (self-hosted, $0)
      "research": "claude-sonnet-4-6"        // best research — shares Anthropic cache with reasoning
    },

  "embedding": "wolverine-embedding-1",  // or use openAI emb-3-small

  "server": {
    "port": 3000,
    "maxRetries": 3,
    "maxMemoryMB": 512
  },

  "telemetry": {
    "enabled": true,
    "heartbeatIntervalMs": 60000
  },

  "rateLimiting": {
    "maxCallsPerWindow": 32,
    "windowMs": 100000,
    "minGapMs": 5000,
    "maxTokensPerHour": 1000000
  },

  "healthCheck": {
    "intervalMs": 15000,
    "timeoutMs": 5000,
    "failThreshold": 3,
    "startDelayMs": 10000
  },

  "errorMonitor": {
    "defaultThreshold": 1,
    "windowMs": 30000,
    "cooldownMs": 60000
  },

  "autoUpdate": {
    "enabled": true,
    "intervalMs": 300000
  },

  "platform": {
    "apiKey": "",
    "cors": ["http://localhost:3000"]
  },

  "dashboard": {},

  "cors": {
    "enabled": true,
    "origins": ["http://localhost:3000"]
  },

  "logging": {
    "level": "info",
    "requests": true,
    "responseTime": true
  }
}
